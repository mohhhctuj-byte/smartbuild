# Server-only first-party email delivery. Copy to .env and fill in values.
APP_BASE_URL=http://localhost:3003
FIRST_PARTY_OWNER_EMAIL=owner@example.com

# Use either Resend or Gmail SMTP. Never expose these values to Vite/client code.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=SmartBuild

# Gmail SMTP requires an app password, not the account password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Required for first-party session and OTP hashing.
JWT_SECRET=replace-with-a-long-random-server-secret

# Required to encrypt per-project API keys. Generate once, store securely, and keep stable across restarts.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROJECT_SECRETS_ENCRYPTION_KEY=replace-with-a-separate-long-random-server-secret

# Optional local AI prototype. Keep false until its responses pass your evaluation set.
LOCAL_AI_ENABLED=false

# Server-only AI provider chain. On quota/network failures, SmartBuild tries the next configured provider.
AI_PROVIDER_ORDER=gemini,groq
# Local Ollama endpoint and models used by production agents.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BUILD_MODEL=qwen2.5-coder:1.5b
OLLAMA_MEDIA_MODEL=qwen2.5vl:3b
# Optional Ollama GPU count; set to 0 if the local GPU crashes or has insufficient memory.
OLLAMA_MEDIA_NUM_GPU=
# Optional path to ffmpeg.exe; required for local video analysis if FFmpeg is not on PATH.
FFMPEG_PATH=
OLLAMA_BUILD_MAX_TOKENS=1200
OLLAMA_TIMEOUT_MS=1800000
OLLAMA_MAX_TOKENS=1600
OLLAMA_KEEP_ALIVE=10m

# Server-only Gemini pool. Comma-separate keys; never expose these to client code.
# Gemini is tried first; quota and network failures move to the next provider in AI_PROVIDER_ORDER.
# Set GEMINI_API_KEY for one key, or use GEMINI_API_KEYS for a comma-separated key pool.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Optional ordered free-model fallback list.
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview

# Optional OpenAI-compatible fallbacks. Keep tokens server-side; never use VITE_ prefixes.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Set GITHUB_MODELS_API_KEY or GITHUB_TOKEN.
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Optional Claude Sonnet 5.5 API key. Keep it server-only; never use VITE_ prefixes.
ANTHROPIC_API_KEY=
